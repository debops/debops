import io
import os
import re
import subprocess
from json import dumps


def cmd_exists(cmd):
    return any(
        os.access(os.path.join(path, cmd), os.X_OK)
        for path in os.environ["PATH"].split(os.pathsep)
    )


def read_file(path):
    try:
        with io.open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read()
    except (IOError, OSError):
        return ""


def get_uid_min():
    for line in read_file("/etc/login.defs").splitlines():
        match = re.match(r"^UID_MIN\s+([0-9]+)", line)
        if match:
            return int(match.group(1))

    # Reasonable default if UID_MIN was not found or could not be parsed.
    return 1000


def get_immutability():
    output = subprocess.check_output(["auditctl", "-s"])
    output = output.decode("utf-8", "replace")
    match = re.search(r"enabled\s+([0-9]+)", output)

    return bool(match and match.group(1) == "2")


installed = cmd_exists("auditctl")

output = {
    "enabled": {{ auditd__enabled | d(False) | bool }},
    "installed": installed,
    "uid_min": get_uid_min(),
    "immutable": get_immutability() if installed else False,
}

print(dumps(output, sort_keys=True, indent=4))
