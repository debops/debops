# {{ ansible_managed }}
#
# Custom UserParameters configured via 'zabbix_agent__user_parameters' and
# related Ansible variables.
{% for item in zabbix_agent__combined_user_parameters %}
{%   if item.key | d() and item.command | d() and (item.state | d('present') != 'absent') %}

{%     if item.comment | d() %}
# {{ item.comment }}
{%     endif %}
UserParameter={{ item.key }}{{ "[*]" if (item.unsafe | d(False) | bool) else "" }},{{ item.command }}
{%   endif %}
{% endfor %}
