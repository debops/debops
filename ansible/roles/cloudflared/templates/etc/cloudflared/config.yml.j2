# {{ ansible_managed }}
#
# cloudflared tunnel configuration for '{{ tunnel.name }}'
# Mode: {{ cloudflared__tunnel_mode }}

{% set cloudflared__tpl_config = cloudflared__default_config
                                 | combine(cloudflared__config,
                                           tunnel.config | d({}),
                                           recursive=True) %}
{% if cloudflared__tunnel_mode == 'local' %}
{%   set cloudflared__tpl_ingress = cloudflared__tpl_config.ingress | d([]) %}
{%   if (cloudflared__tpl_ingress | length == 0) or
        ((cloudflared__tpl_ingress | last).hostname is defined) or
        ((cloudflared__tpl_ingress | last).path is defined) %}
{%     set cloudflared__tpl_ingress = cloudflared__tpl_ingress
                                      + [ {'service': (tunnel.catch_all_service
                                                       | d(cloudflared__catch_all_service))} ] %}
{%   endif %}
{%   set cloudflared__tpl_config = cloudflared__tpl_config
                                   | combine({'tunnel': tunnel.tunnel_uuid,
                                              'credentials-file': cloudflared__tunnel_secret_file,
                                              'ingress': cloudflared__tpl_ingress}) %}
{% else %}
{%   set cloudflared__tpl_config = cloudflared__tpl_config
                                   | combine({'token-file': cloudflared__tunnel_secret_file}) %}
{% endif %}
{{ cloudflared__tpl_config | to_nice_yaml(indent=2, width=1000) }}
