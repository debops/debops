from __future__ import print_function
from json import dumps
import subprocess
import os
import re

bin_path = {{vmagent__bin_path | to_json}}
config_dir = {{vmagent__config_dir | to_json}}

output = {}
output['installed'] = os.access(bin_path, os.X_OK)

try:
    version_stdout = subprocess.check_output(
            [bin_path, "-version"],
            stderr=subprocess.STDOUT,
            timeout=10
            ).decode('utf-8', errors='replace').strip()

    version_match = re.search(r'(\d+\.\d+\.\d+)', version_stdout)
    if version_match:
        output['version'] = version_match.group(1)

except Exception:
    pass

instances = []
seen = set()

try:
    if os.path.isdir(config_dir):
        for name in sorted(os.listdir(config_dir)):
            if name.endswith('.yml'):
                seen.add(name[:-4])

    units_stdout = subprocess.check_output(
            ["systemctl", "list-units", "--all",
             "vmagent@*.service",
             "--no-legend", "--plain"],
            stderr=subprocess.STDOUT,
            timeout=10
            ).decode('utf-8', errors='replace').strip()

    for line in units_stdout.split('\n'):
        if line.strip():
            unit_name = line.split()[0]
            match = re.search(r'vmagent@(.+)\.service', unit_name)
            if match:
                seen.add(match.group(1))

    for instance_name in sorted(seen):
        active_state = 'unknown'
        try:
            active_state = subprocess.check_output(
                    ["systemctl", "is-active",
                     "vmagent@{}.service".format(instance_name)],
                    stderr=subprocess.STDOUT,
                    timeout=10
                    ).decode('utf-8', errors='replace').strip()
        except subprocess.CalledProcessError as e:
            active_state = e.output.decode('utf-8', errors='replace').strip()

        instances.append({
            'name': instance_name,
            'active': active_state
        })

except Exception as exc:
    # Keep fact collection successful (DebOps convention) but show why the
    # instance list is empty, so that an error does not look like a host
    # without instances.
    output['instances_query_error'] = type(exc).__name__

output['instances'] = instances

print(dumps(output, sort_keys=True, indent=4))
