# {{ ansible_managed }}

# Ansible-managed configuration drop-in for Zabbix Server.
# Loaded via "Include={{ zabbix_server__conf_directory }}/*.conf" already
# present in the stock /etc/zabbix/zabbix_server.conf file.
{% for element in zabbix_server__combined_configuration | debops.debops.parse_kv_config %}
{%   if element.name | d() and element.value is defined and element.state | d('present') not in [ 'absent', 'ignore', 'init' ] %}

{{     element.comment | d('') | regex_replace('\n$','') | comment() }}
{%     set element_comment = ('#' if element.state | d('present') == 'comment' else '') %}
{%     if element.value is iterable and element.value is not string and element.value is not mapping %}
{%       for value in element.value %}
{%         if value is not mapping %}
{{           '{}{}={}'.format(element_comment, element.option | d(element.name), value) }}
{%         elif value.state | d('present') not in [ 'absent', 'ignore', 'init' ] %}
{%           set value_comment = ('#' if value.state | d('present') == 'comment' else element_comment) %}
{{           '{}{}={}'.format(value_comment, element.option | d(element.name), value.value | d(value.name)) }}
{%         endif %}
{%       endfor %}
{%     else %}
{{       '{}{}={}'.format(element_comment, element.option | d(element.name), element.value) }}
{%     endif %}
{%   endif %}
{% endfor %}
