    "templates": [
      {
        "uuid": "624f89d412e9478ba547f505ecc10e96",
        "template": "LXC CPU cgroup",
        "name": "LXC container",
        "description": "Per-container CPU (cgroup usage_usec) and memory pressure (MemTotal-MemAvailable).\nct.memory.* deliberately ignores reclaimable page cache in memory.current.\nHost loadavg / system.cpu.util on LXC are misleading -- use dashboard \"LXC performance\".\nRequires the zabbix_agent role's cgroup_metrics UserParameters on the LXC container.",
        "groups": [
          {
            "name": "Templates/Applications"
          }
        ],
        "items": [
          {
            "uuid": "3bfeb8a536cf4f21a7de893fc0d198af",
            "name": "LXC: CPU utilization (cgroup)",
            "type": "ZABBIX_ACTIVE",
            "key": "ct.cpu.util",
            "delay": "1m",
            "history": "7d",
            "trends": "90d",
            "value_type": "FLOAT",
            "units": "%",
            "description": "Share of container CPUs (nproc) from /sys/fs/cgroup/cpu.stat usage_usec over 1s.",
            "tags": [
              {
                "tag": "component",
                "value": "cpu"
              }
            ],
            "triggers": [
              {
                "uuid": "8b8411a891d24dc289d0e81852457fa8",
                "expression": "min(/LXC CPU cgroup/ct.cpu.util,5m)>{$CT.CPU.UTIL.MAX.WARN}",
                "name": "LXC: CPU utilization is too high (over {$CT.CPU.UTIL.MAX.WARN}% for 5m)",
                "priority": "AVERAGE",
                "description": "Cgroup CPU for this container, not host load average."
              }
            ]
          },
          {
            "uuid": "3ffc6f18211d4da39cf54c5560c8ce0f",
            "name": "LXC: Memory used (pressure)",
            "type": "ZABBIX_ACTIVE",
            "key": "ct.memory.used",
            "delay": "1m",
            "history": "7d",
            "trends": "90d",
            "value_type": "UNSIGNED",
            "units": "B",
            "description": "(MemTotal - MemAvailable) via LXCFS. Not cgroup memory.current (page cache).",
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ]
          },
          {
            "uuid": "cfc6b714af9941cb80ead5fca55a3c33",
            "name": "LXC: Memory utilization (pressure)",
            "type": "ZABBIX_ACTIVE",
            "key": "ct.memory.util",
            "delay": "1m",
            "history": "7d",
            "trends": "90d",
            "value_type": "FLOAT",
            "units": "%",
            "description": "100*(MemTotal-MemAvailable)/MemTotal. Ignores reclaimable page cache in memory.current.",
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ],
            "triggers": [
              {
                "uuid": "216fbf53cd0041009e98ba8a08e99698",
                "expression": "min(/LXC CPU cgroup/ct.memory.util,5m)>{$CT.MEMORY.UTIL.MAX.WARN}",
                "name": "LXC: Memory utilization is too high (over {$CT.MEMORY.UTIL.MAX.WARN}% for 5m)",
                "priority": "AVERAGE",
                "description": "Memory pressure (not cgroup charge with page cache)."
              }
            ]
          }
        ],
        "macros": [
          {
            "macro": "{$CT.CPU.UTIL.MAX.WARN}",
            "value": "85",
            "description": "Warn when CT CPU util (cgroup, % of nproc) stays above this for 5m"
          },
          {
            "macro": "{$CT.MEMORY.UTIL.MAX.WARN}",
            "value": "90",
            "description": "Warn when CT memory pressure util stays above this for 5m"
          }
        ],
