# SSH known_hosts configuration of the '{{ view_name }}' view. The
# '${DEBOPS_PROJECT_PATH}' reference is expanded by DebOps when the
# configuration is loaded and by Ansible when the 'ansible.cfg' file is
# parsed.

[ssh]
known_hosts = 'project'

[views.{{ view_name }}.ansible.ssh_connection]
ssh_args = ["-o 'UserKnownHostsFile=${DEBOPS_PROJECT_PATH}/{{ store_path }}'"]
