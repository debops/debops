# OpenTofu providers required by this view
#
# Generated by DebOps from the 'views.<view>.tofu.providers' option of
# the view's configuration drop-in. The recorded set is changed by
# editing the drop-in; this file is regenerated by the 'debops tofu
# update' command when the recorded set changes.

terraform {
  required_providers {
{% for provider in providers %}
    {{ provider.name }} = {
      source{{ ' ' if provider.version }} = "{{ provider.source }}"
{% if provider.version %}
      version = "{{ provider.version }}"
{% endif %}
    }
{% endfor %}
  }
}
