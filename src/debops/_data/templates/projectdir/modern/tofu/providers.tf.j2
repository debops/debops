# OpenTofu providers required by this view
#
# Generated by DebOps from the 'views.<view>.tofu.providers' option of
# the view's configuration drop-in. The provider set is changed through
# the '--provider' options of the 'debops tofu init' command; this
# file is regenerated when the recorded set changes.

terraform {
  required_providers {
{% for provider in providers %}
    {{ provider.name }} = {
      source = "{{ provider.source }}"
{% if provider.version %}
      version = "{{ provider.version }}"
{% endif %}
    }
{% endfor %}
  }
}
