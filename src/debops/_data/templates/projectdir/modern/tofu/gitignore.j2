#-- DebOps project environment
# See https://docs.debops.org/en/master/user-guide/project-directories.html

#-- OpenTofu working data, relocated by the 'debops tofu' wrapper
/.terraform/

#-- OpenTofu plan files, transient: the plan files which the
# 'debops tofu plan' operation saves beside the view configuration
# are pruned by the 'tofu.plan_retention' option; the operator's own
# '-out' plans in the directory stay untracked as well
/plans/

#-- OpenTofu state backups: the rolling prior-state copy the local
# backend writes beside the state on every apply. The state itself is
# tracked -- the git history is the version record -- and the backups
# are the just-in-case net of the backend.
*.backup

#-- OpenTofu state files, encrypted at rest by OpenTofu itself
# The state is tracked: the native encryption protects it at rest and
# in the git history. The '.terraform.lock.hcl' file and the '*.tfvars'
# files are committed as well: the variable files which carry secrets
# belong under 'secret/', where the store's routing encrypts them.

# EncFS mount targets
# Uncomment this line if you want to use EncFS as secret storage
{% if encrypted_secrets == 'encfs' %}
/{{ secret_name }}
{% else %}
#/{{ secret_name }}
{% endif %}

# EncFS encrypted folders
# Uncomment this line if you don't want to use EncFS filesystem in the git
# repository
#/{{ encfs_prefix }}{{ secret_name }}
