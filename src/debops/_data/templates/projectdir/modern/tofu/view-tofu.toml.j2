# OpenTofu provider requirements of the '{{ view_name }}' view.
#
# Generated by DebOps from the '--provider' options of the
# 'debops tofu init' command and the 'tofu.default_providers'
# configuration option, which seed the set when the view is created.
# The provider set is changed by editing this drop-in; the generated
# 'providers.tf' file of the view follows this option.

[views."{{ view_name }}".tofu]
providers = [{% for provider in providers %}'{{ provider }}'{{ ", " if not loop.last }}{% endfor %}]
