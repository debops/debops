# OpenTofu dependency requirements of the '{{ view_name }}' view.
#
# Generated by DebOps from the '--provider' and '--module' options of
# the 'debops tofu init' command and the 'tofu.default_providers' and
# 'tofu.default_modules' configuration options, which seed the set
# when the view is created. The dependency set is changed by editing
# this drop-in; the generated 'providers.tf' and 'modules.tf' files of
# the view follow these options.

[views."{{ view_name }}".tofu]
providers = [{% for provider in providers %}'{{ provider }}'{{ ", " if not loop.last }}{% endfor %}]
{% for module in modules %}

[views."{{ view_name }}".tofu.modules."{{ module.name }}"]
source = '{{ module.source }}'
{% if module.version %}
version = '{{ module.version }}'
{% endif %}
{% if module.inputs_toml %}

[views."{{ view_name }}".tofu.modules."{{ module.name }}".inputs]
{{ module.inputs_toml }}
{% endif %}
{% endfor %}
