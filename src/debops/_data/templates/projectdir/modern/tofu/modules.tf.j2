# OpenTofu modules instantiated by this view
#
# Generated by DebOps from the 'views.<view>.tofu.modules' option of
# the view's configuration drop-in. The recorded set is changed by
# editing the drop-in; this file is regenerated by the 'debops tofu
# update' command when the recorded set changes.

{% for module in modules %}
module "{{ module.name }}" {
  source{{ ' ' if module.version }} = "{{ module.source }}"
{% if module.version %}
  version = "{{ module.version }}"
{% endif %}
{% if module.inputs %}

{{ module.inputs }}
{% endif %}
}
{% if not loop.last %}

{% endif %}
{% endfor %}
