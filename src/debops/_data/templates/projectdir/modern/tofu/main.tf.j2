# OpenTofu configuration of the '{{ view_name }}' view
#
# The state of the view lives in the 'state/' directory, encrypted at
# rest by OpenTofu itself and tracked in git as ciphertext; the
# passphrase comes from the store's 'environment' file through the
# 'debops tofu' wrapper. The provider requirements of the view are
# managed by DebOps in the 'providers.tf' file.

terraform {
  required_version = ">= {{ tofu_version }}"

  backend "local" {
    path          = "state/terraform.tfstate"
    workspace_dir = "state/workspaces"
  }

  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.state_passphrase
    }

    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }

    state {
      method   = method.aes_gcm.state
      enforced = true
    }

    plan {
      method = method.aes_gcm.state
    }
  }
}

variable "state_passphrase" {
  type      = string
  sensitive = true
}
