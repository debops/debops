# Configuration of the Python virtual environment encapsulated in the
# project directory, managed by the 'debops project venv' command

project:
  venv:

    # Enable the Python virtual environment in this project
    enabled: True

    # Path to the virtual environment, relative to the project directory;
    # an absolute path can point outside of the project to share one
    # environment between multiple projects
    path: '.debops/venv'

    # Path to the file with pinned Python package versions, relative to the
    # project directory
    requirements: '.debops/requirements.txt'

    # Python interpreter used to create the virtual environment
    python: 'python3'
