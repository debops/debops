# codespell configuration for the Super-Linter workflow. License texts
# are upstream content; the 'aci' word is a legit collection name
# (cisco.aci). The Continuous Integration job keeps the default
# configuration; this file is Super-Linter's.
[codespell]
skip = .mailmap,LICENSES
ignore-words-list = aci
